{
  "name": "dsh-composer-quill",
  "version": "0.33.3",
  "type": "module",
  "description": "在 DSH 的输入框里提前把话写好：回合结束后给出下一句，打字时补完后半句，顺手修掉错字和标点。",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yugyq/dsh-composer-quill.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "client",
    "dev/tools/build-client.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/ARCHITECTURE.md",
    "docs/DETAIL.md",
    "docs/DEVELOPMENT.md",
    "docs/PROTOCOL.md",
    "docs/REQUEST_STATE_MACHINE.md",
    "docs/REQUEST_TRIGGERS.md",
    "docs/assets",
    "icon.svg",
    "README.md",
    "README.en.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "assets",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "homepage": "https://github.com/yugyq/dsh-composer-quill#readme",
  "bugs": {
    "url": "https://github.com/yugyq/dsh-composer-quill/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "plugin",
    "composer",
    "autocomplete",
    "completion",
    "ghost-text",
    "llm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/smoke-test.mjs",
    "test:ui": "npm run harness:build && python dev/verify/verify_daily.py",
    "test:all": "npm test && npm run test:ui",
    "test:log": "node dev/tools/summarize-log.mjs 1",
    "test:ui:retry": "python dev/verify/verify_with_retry.py --attempts 2 --threshold 3",
    "build:client": "node dev/tools/build-client.mjs",
    "check:client": "node dev/tools/build-client.mjs --check",
    "harness:build": "node dev/harness/build.mjs",
    "harness:install": "npm ci --prefix dev/harness --no-audit --no-fund"
  }
}
